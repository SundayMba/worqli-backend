# Staging secrets — copy to `.env.staging` ON THE SERVER (never commit the real file).
#   cp .env.staging.example .env.staging   then fill it in.
# Used by: docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
#
# Staging is deliberately lean: no real Paystack (stub gateways = fake money), no
# S3 (local disk), KYC auto-approved. You only strictly need the two below.

# A separate database password from production (any strong string).
POSTGRES_PASSWORD=change_me_staging_db_password

# A real JWT signing key, >= 32 chars (staging still signs tokens). Generate one:
#   openssl rand -base64 48
JWT_SIGNING_KEY=change_me_long_random_at_least_32_chars

# ── Optional (leave unset for the lean stub-everything staging) ──
# Email OTP: set to send real verification emails; unset => codes logged as [DEV-OTP].
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=no-reply@send.servika.com.ng
# RESEND_FROM_NAME=Servika Staging

# Real payments on staging (usually NOT wanted — leave blank for the stub gateway).
# PAYSTACK_SECRET_KEY=

# Road routing / Google sign-in on staging (optional).
# GOOGLE_DIRECTIONS_API_KEY=
# GOOGLE_OAUTH_CLIENT_IDS=

# A SEPARATE staging S3 bucket (optional; blank => ephemeral local disk).
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=eu-west-1

# KYC_AUTOAPPROVE=true
