# TEMPLATE ONLY — safe to commit (no real values).
# On the SERVER, copy this to `.env` and fill in real values:  cp .env.example .env
# The real `.env` is gitignored and must NEVER be committed.

# Database password — pick a long random string (used by Postgres and the API).
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# JWT signing secret — a long random string, at least 32 characters.
JWT_SIGNING_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Email delivery (Resend). Leave the key blank to just log OTP codes to the server
# instead of sending real emails (fine while testing).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Servika

# Payments (Paystack). Blank = built-in stub gateway (no real money moves).
PAYSTACK_SECRET_KEY=

# Google Directions (live road routing + traffic ETA). Blank = straight-line fallback.
GOOGLE_DIRECTIONS_API_KEY=

# KYC auto-approve. true = artisans self-verify instantly (launch/testing);
# set false once you're doing manual document review from the admin dashboard.
KYC_AUTOAPPROVE=true
