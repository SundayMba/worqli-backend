{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=servika;Username=servika;Password=servika_dev_password",
    "Redis": "localhost:6379"
  },
  "_comment_Jwt": "The Worker shares Infrastructure DI, which binds a Jwt section — but the Worker never issues tokens, so this is inert (not a real secret).",
  "Jwt": {
    "Issuer": "servika-api",
    "Audience": "servika-app",
    "SigningKey": "worker-does-not-issue-tokens-inert-placeholder-key",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Tracking": {
    "SweepSeconds": 60,
    "StaleAfterSeconds": 180
  },
  "Completion": {
    "SweepMinutes": 30
  }
}
