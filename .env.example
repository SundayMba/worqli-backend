# ─────────────────────────────────────────────────────────────────────────────
# Servika backend — environment template. SAFE TO COMMIT (no real values).
# On the SERVER:  cp .env.example .env  then fill in real values. `.env` is
# gitignored and must NEVER be committed.
#
# You do NOT need this file for local dev — leave every secret blank and the API
# falls back to safe dev stubs (logs OTP codes, stub payments/payouts/SMS, phone
# gate off). Locally, prefer `dotnet user-secrets` over a .env file.
#
# Names below are the friendly form; docker-compose.prod.yml maps each to its
# ASP.NET config key (e.g. PAYSTACK_SECRET_KEY -> Paystack__SecretKey). If you run
# the API without compose, set the `Xxx__Yyy` env var directly instead.
# ─────────────────────────────────────────────────────────────────────────────

# == REQUIRED IN PRODUCTION — the API refuses to boot without these ==

# Database password — a long random string (Postgres and the API share it).
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# JWT signing secret — a long random string, at least 32 chars (the appsettings
# "REPLACE_WITH…" placeholder is rejected in Production).
JWT_SIGNING_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Payments + payouts (Paystack). REQUIRED in Production: a blank key selects the
# STUB gateway, which trusts every webhook signature (fail-open). This one key
# drives card charges, escrow, artisan/referral bank transfers AND the bank list.
# Dashboard steps: turn OFF "Transfers OTP" and get the business approved for
# Transfers with a funded balance, or payouts can't auto-complete.
PAYSTACK_SECRET_KEY=

# NOTE: CORS allowed origins live in appsettings.json (admin/site/localhost). The
# API refuses to boot in Production if that list is empty.

# == OPTIONAL INTEGRATIONS — blank = safe dev fallback ==

# Email delivery (Resend). Blank = OTP codes are logged to the server, not emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@send.servika.com.ng
RESEND_FROM_NAME=Servika

# Phone-verification OTP (Termii) — WhatsApp-first with SMS fallback. Blank = dev
# stub logs the code (no SMS sent). Provision on Termii first: a WhatsApp OTP
# message template + an approved sender id on the transactional/DND route.
SMS_API_KEY=
SMS_SENDER_ID=Servika

# Google Directions (live road routing + traffic ETA). Blank = straight-line fallback.
GOOGLE_DIRECTIONS_API_KEY=

# Routing without Google: any OSRM-compatible service. Takes priority over Google when set.
#   LocationIQ (free tier, no card): OSRM_BASE_URL=https://us1.locationiq.com/v1/directions  OSRM_API_KEY=pk.xxx
#   Self-hosted OSRM:                OSRM_BASE_URL=http://osrm:5000
OSRM_BASE_URL=
OSRM_API_KEY=

# Google Sign-In: comma-separated WEB OAuth client id(s) the API accepts as the
# ID-token audience. Blank = the /auth/google endpoint rejects all.
GOOGLE_OAUTH_CLIENT_IDS=

# S3 uploads (KYC docs, profile/cover/gallery photos, booking media). Blank = local
# disk, which is EPHEMERAL (lost on redeploy) — set these in Production.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=

# == FEATURE FLAGS ==

# KYC auto-approve. true = artisans self-verify instantly (early testing);
# false = manual document review via the admin dashboard (the launch default).
KYC_AUTOAPPROVE=false

# Require a VERIFIED PHONE before a customer can book or chat. Keep false until
# SMS_API_KEY is set and the apps prompt for it. ⚠️ The API refuses to boot if this
# is true while SMS_API_KEY is blank (customers couldn't receive codes).
REQUIRE_PHONE_FOR_BOOKING=false

# ── Scaling out (only when running >1 API instance) ────────────────────────────
# Run ONE Servika.Worker process (same solution, `dotnet Servika.Worker.dll`, with
# ConnectionStrings__Postgres) for the background sweeps, and set this to false on
# every API instance so the sweeps run exactly once. A single API instance needs
# neither (sweeps run in-process by default).
# WORKER_RUN_SWEEPS_IN_API=true
